// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users
// Document ID: {uid}
// Fields:
//   - uid: string (required) - Firebase Auth UID
//   - email: string (required) - User email
//   - displayName: string (optional) - User display name
//   - photoURL: string (optional) - User photo URL
//   - role: string (required) - 'user' or 'admin'
//   - createdAt: timestamp (required) - Creation time
//
// Collection: hiddenGems
// Document ID: {gemId}
// Fields:
//   - name: string (required)
//   - description: string (required)
//   - crowdLevel: string (required) - 'low', 'medium', 'high'
//   - safetyStatus: string (required) - 'safe', 'caution', 'restricted'
//   - ... (other metadata)
//
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email == "poudelpawan770@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid is string &&
             data.email is string &&
             data.role in ['user', 'admin'];
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && isValidUser(request.resource.data) && 
                      ((isOwner(userId) && request.resource.data.role == 'user') || isAdmin());
      allow update: if isAuthenticated() && isValidUser(request.resource.data) && 
                      ((isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin());
    }

    match /hiddenGems/{gemId} {
      allow read: if true; // Publicly readable for tourists
      allow write: if isAdmin();
    }

    match /safetyChecks/{checkId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
    }
  }
}
